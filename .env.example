NODE_ENV=development

# Aplicativo / Web
APP_NOME=Meu Bolso
APP_URL=http://localhost:8081
SITE_URL=http://localhost:8081
API_EXTERNAL_URL=http://localhost:3000
ORIGENS_PERMITIDAS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
VITE_PLUGGY_BACKEND_URL=http://localhost:3000

# Backend Node.js
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
BODY_LIMIT=1mb
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=15000

# JWT / Sessao
JWT_SECRET=preencher_com_valor_forte
JWT_REFRESH_SECRET=preencher_com_valor_forte
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSAO_COOKIE_NAME=meu_bolso_sessao

# PostgreSQL
POSTGRES_DB=meu_bolso
POSTGRES_USER=meu_bolso
POSTGRES_PASSWORD=preencher_com_valor_forte
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://meu_bolso:preencher_com_valor_forte@postgres:5432/meu_bolso

# Supabase self-hosted
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=preencher
SUPABASE_SERVICE_ROLE_KEY=preencher
SUPABASE_JWT_SECRET=preencher_com_valor_forte
SUPABASE_DB_PASSWORD=preencher_com_valor_forte

# Auth / Google
GOOGLE_CLIENT_ID=preencher
GOOGLE_CLIENT_SECRET=preencher

# Pluggy
PLUGGY_CLIENT_ID=preencher
PLUGGY_CLIENT_SECRET=preencher
PLUGGY_API_URL=https://api.pluggy.ai
PLUGGY_WEBHOOK_SECRET=preencher
PLUGGY_PROXY_PORT=8787
PLUGGY_PROXY_HOST=0.0.0.0

# Dominio / Proxy reverso
DOMINIO_APP=app.exemplo.com
DOMINIO_API=api.exemplo.com
DOMINIO_SUPABASE=supabase.exemplo.com
EMAIL_LETSENCRYPT=admin@exemplo.com

# Backup
BACKUP_BUCKET_S3=s3://bucket-exemplo
BACKUP_S3_ENDPOINT=https://s3.exemplo.com
BACKUP_S3_ACCESS_KEY=preencher
BACKUP_S3_SECRET_KEY=preencher
BACKUP_RETENCAO_DIARIA=7
BACKUP_RETENCAO_SEMANAL=4
BACKUP_RETENCAO_MENSAL=3

# Monitoramento
HEALTHCHECK_TOKEN=preencher
ALERTA_EMAIL=ops@exemplo.com
